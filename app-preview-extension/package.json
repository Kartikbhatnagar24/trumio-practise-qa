{
	"name": "app-preview",
	"displayName": "App Preview",
	"description": "Opens apps running in the workspace in a panel next to the editor",
	"version": "0.1.0",
	"publisher": "trumio",
	"private": true,
	"engines": {
		"vscode": "^1.85.0"
	},
	"categories": [
		"Other"
	],
	"activationEvents": [
		"onStartupFinished"
	],
	"main": "./out/extension.js",
	"contributes": {
		"commands": [
			{
				"command": "appPreview.open",
				"title": "Open App Preview",
				"category": "App Preview",
				"icon": "$(play)"
			}
		],
		"menus": {
			"commandPalette": [
				{
					"command": "appPreview.open",
					"when": "appPreview.enabled"
				}
			],
			"editor/title": [
				{
					"command": "appPreview.open",
					"when": "appPreview.enabled",
					"group": "navigation"
				}
			]
		}
	},
	"scripts": {
		"build": "tsc -p .",
		"package": "npm run build && mkdir -p builds && vsce package --skip-license --allow-missing-repository --out builds/app-preview-$npm_package_version.vsix"
	},
	"devDependencies": {
		"@types/node": "20.17.6",
		"@types/vscode": "1.85.0",
		"@vscode/vsce": "3.2.1",
		"typescript": "5.6.3"
	}
}
